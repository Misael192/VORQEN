{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://plataforma:plataforma@localhost:5432/plataforma} nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "PRISMA_GENERATE_SKIP_AUTOINSTALL=true prisma generate --schema=../../prisma/schema.prisma && node ../../scripts/fix-prisma-client.cjs",
    "prisma:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "lint": "echo 'No lint configured yet'"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.8",
    "@prisma/client": "6.19.3",
    "@vorqen/ai-core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.spec.json" }]
    },
    "testEnvironment": "node"
  }
}
