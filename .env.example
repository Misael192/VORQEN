# Variáveis de ambiente — VORQEN
# Copie para .env.local (apps/web) ou .env (apps/api). NUNCA versione valores.
# Regra R11: este arquivo contém apenas NOMES, jamais chaves/tokens/senhas.

# ── Banco (PostgreSQL + Prisma) ───────────────────────────────
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=
SESSION_COOKIE_NAME=vorqen_session

# ── Provedores de IA (nomes de variável lidos pelo ai-core registry) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama roda localmente; sem chave. Ajuste a porta se necessário:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Pagamentos (Etapa 5) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email transacional (Etapa 5) ──────────────────────────────
RESEND_API_KEY=

# ── Preview / WebContainer (Etapa 4) ──────────────────────────
# WebContainer roda 100% no navegador; nada sensível aqui.
