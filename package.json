{
  "name": "vorqen",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "prisma:generate": "pnpm -r --if-present prisma:generate",
    "prisma:migrate": "pnpm -r --if-present prisma:migrate -- --name init",
    "lint": "pnpm -r --if-present lint"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
